<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Recyclage"
             xmlns:behaviors="using:Recyclage.Behaviors"
             xmlns:conv="using:Recyclage.Converters"
             x:Class="Recyclage.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <Color x:Key="EditActionColor">#EA580C</Color>
        <Color x:Key="DeleteActionColor">#DC2626</Color>
        <Color x:Key="SaveActionColor">#16A34A</Color>
        <Color x:Key="TableGridLineColor">#D4B87A</Color>
        <Color x:Key="InputFieldColor">#B8955A</Color>
        <Color x:Key="InputFieldBackgroundColor">#FBF6EC</Color>
        <SolidColorBrush x:Key="EditActionBrush" Color="{StaticResource EditActionColor}"/>
        <SolidColorBrush x:Key="DeleteActionBrush" Color="{StaticResource DeleteActionColor}"/>
        <SolidColorBrush x:Key="SaveActionBrush" Color="{StaticResource SaveActionColor}"/>
        <SolidColorBrush x:Key="TableGridLineBrush" Color="{StaticResource TableGridLineColor}"/>
        <SolidColorBrush x:Key="InputFieldBrush" Color="{StaticResource InputFieldColor}"/>
        <SolidColorBrush x:Key="InputFieldBackgroundBrush" Color="{StaticResource InputFieldBackgroundColor}"/>
        <SolidColorBrush x:Key="ActionButtonTextBrush" Color="White"/>
        <conv:NegativeAmountBrushConverter x:Key="NegativeAmountBrushConverter"/>
        <!-- The Fluent DataGridColumnHeader template reserves a fixed-width column for the
             sort arrow (DataGridSortIconMinWidth = 32) and keeps it even while the arrow
             is hidden, because a ColumnDefinition MinWidth ignores child visibility.
             Zeroing it here gives the whole column width back to the title. -->
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
        </Style>
        <Style Selector="UserControl">
            <Setter Property="FontFamily" Value="Segoe UI, Tahoma, Arial"/>
        </Style>

        <Style Selector="DataGrid">
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="BorderBrush" Value="{StaticResource TableGridLineBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource TableGridLineBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource TableGridLineBrush}"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="BorderBrush" Value="{StaticResource TableGridLineBrush}"/>
        </Style>
        <Style Selector="DataGridCell TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="52"/>
            <!-- Headers carry no inset of their own: the column width is the whole
                 budget, so any padding here eats space the title needs to stay on one line. -->
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{StaticResource TableGridLineBrush}"/>
        </Style>
        <Style Selector="DataGridColumnHeader TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource InputFieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="TextBox.numeric-input">
            <Setter Property="behaviors:TextBoxFocusBehavior.SelectAllOnFocus" Value="True"/>
        </Style>
        <!-- Cash-only invoice lines have no product, so الكمية / ثمن / نقل are disabled.
             The explicit Background and BorderBrush above would otherwise mask the theme's
             disabled look and leave the box looking editable while ignoring clicks. -->
        <Style Selector="TextBox.numeric-input:disabled">
            <Setter Property="Background" Value="#F1EDE4"/>
            <Setter Property="BorderBrush" Value="#DED7C6"/>
            <Setter Property="Foreground" Value="#A8A29A"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource InputFieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource InputFieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="ComboBox:focus /template/ Border#Background">
            <Setter Property="Background" Value="{StaticResource InputFieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>

        <Style Selector="CalendarDatePicker">
            <Setter Property="Background" Value="{StaticResource InputFieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="CalendarDatePicker:focus">
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>
        <Style Selector="CalendarDatePicker:pointerover">
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
        </Style>

        <Style Selector="Button.edit-action">
            <Setter Property="Background" Value="{StaticResource EditActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.edit-action /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.edit-action:pointerover">
            <Setter Property="Background" Value="{StaticResource EditActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditActionBrush}"/>
        </Style>
        <Style Selector="Button.edit-action:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.edit-action:pressed">
            <Setter Property="Background" Value="{StaticResource EditActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditActionBrush}"/>
        </Style>
        <Style Selector="Button.edit-action:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>

        <Style Selector="Button.delete-action">
            <Setter Property="Background" Value="{StaticResource DeleteActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DeleteActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.delete-action /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.delete-action:pointerover">
            <Setter Property="Background" Value="{StaticResource DeleteActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DeleteActionBrush}"/>
        </Style>
        <Style Selector="Button.delete-action:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.delete-action:pressed">
            <Setter Property="Background" Value="{StaticResource DeleteActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DeleteActionBrush}"/>
        </Style>
        <Style Selector="Button.delete-action:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>

        <Style Selector="Button.save-action">
            <Setter Property="Background" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.save-action /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.save-action:pointerover">
            <Setter Property="Background" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SaveActionBrush}"/>
        </Style>
        <Style Selector="Button.save-action:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.save-action:pressed">
            <Setter Property="Background" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SaveActionBrush}"/>
        </Style>
        <Style Selector="Button.save-action:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>

        <Style Selector="Button.month-filter">
            <Setter Property="Background" Value="{StaticResource InputFieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputFieldBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.month-filter /template/ ContentPresenter">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.month-filter.selected">
            <Setter Property="Background" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.month-filter.selected /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.month-filter.selected:pointerover">
            <Setter Property="Background" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.month-filter.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.month-filter.selected:pressed">
            <Setter Property="Background" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
        </Style>
        <Style Selector="Button.month-filter.selected:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource ActionButtonTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.month-filter.current">
            <Setter Property="BorderBrush" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.month-filter.current:not(.selected) /template/ ContentPresenter">
            <Setter Property="Foreground" Value="{StaticResource SaveActionBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Application.Styles>
</Application>
