<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Recyclage.Views"
        xmlns:vm="using:Recyclage.ViewModels"
        x:Class="Recyclage.MainWindow"
        x:DataType="vm:AppShellViewModel"
        Title="Recyclage — إعادة التدوير"
        Width="1200"
        Height="760"
        MinWidth="960"
        MinHeight="560">

    <views:AppShellView DataContext="{Binding}"/>
</Window>
