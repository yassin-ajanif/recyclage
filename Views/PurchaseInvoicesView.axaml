<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             x:Class="Recyclage.Views.PurchaseInvoicesView"
             x:DataType="vm:PurchaseInvoicesViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            <TextBlock Text="عرض كامل — محسوب من جدول المشتريات" Opacity="0.6" FontSize="13" HorizontalAlignment="Stretch" TextAlignment="Right"/>
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="*,Auto">
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="All"
                      BorderThickness="1,1,1,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="تاريخ" Binding="{Binding Date}" Width="110"/>
                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="منتج" Binding="{Binding Product}" Width="*"/>
                <DataGridTextColumn Header="مورد" Binding="{Binding Supplier}" Width="160" MinWidth="140"/>
                <DataGridTextColumn Header="ثمن" Binding="{Binding UnitPrice}" Width="100"/>
                <DataGridTextColumn Header="نقل" Binding="{Binding TransportCost}" Width="100"/>
                <DataGridTextColumn Header="المجموع" Binding="{Binding Total}" Width="110"/>
                <DataGridTextColumn Header="دفع" Binding="{Binding Paid}" Width="100"/>
                <DataGridTextColumn Header="الباقي" Binding="{Binding Remaining}" Width="100"/>
            </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Background="#FAF8F5"
                    BorderBrush="{StaticResource TableGridLineBrush}"
                    BorderThickness="1,0,1,1"
                    Padding="0,8">
                <Grid ColumnDefinitions="110,90,*,160,100,100,110,100,100">
                    <StackPanel Grid.Column="6" Margin="8,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="المجموع" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:0.00} د.م}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="7" Margin="8,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="دفع" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPaid, StringFormat={}{0:0.00} د.م}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="8" Margin="8,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="الباقي" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalRemaining, StringFormat={}{0:0.00} د.م}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
