<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             x:Class="Recyclage.Views.SupplierInvoiceReportView"
             x:DataType="vm:SupplierInvoiceReportViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            <TextBlock Text="اضغط «تعديل» لتغيير سطر، أو اكتب في السطر الأخير ثم «حفظ»."
                       Opacity="0.6"
                       FontSize="13"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Right"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8" HorizontalAlignment="Left">
            <TextBlock Text="اختر المورد:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier}"
                      MinWidth="220"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,8">
            <TextBlock Text="أضف منتجات «للشراء» من الإعدادات → المنتجات"
                       Foreground="#B45309"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ShowBuyingProductsHint}"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#B45309"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="#D1D5DB">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="تاريخ" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Date}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding Date, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الكمية" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding Quantity, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="منتج" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <ComboBox ItemsSource="{Binding ProductNames}"
                                          SelectedItem="{Binding ProductName, Mode=TwoWay}"
                                          PlaceholderText="اختر منتج"
                                          MinWidth="140"
                                          HorizontalAlignment="Stretch"
                                          IsVisible="{Binding IsEditing}"
                                          SelectionChanged="OnProductChanged"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="ثمن" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding UnitPrice}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding UnitPrice, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="نقل" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding TransportCost}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding TransportCost, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="المجموع" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <TextBlock Text="{Binding Total}" Margin="4,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="دفع" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Paid}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding Paid, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الباقي" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <TextBlock Text="{Binding Remaining}" Margin="4,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="إجراءات" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:PurchaseInvoiceEntryRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Classes="edit-action" Content="تعديل"
                                        Command="{Binding $parent[DataGrid].((vm:SupplierInvoiceReportViewModel)DataContext).BeginEditRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowEditDelete}"
                                        Padding="8,4"/>
                                <Button Classes="delete-action" Content="حذف"
                                        Command="{Binding $parent[DataGrid].((vm:SupplierInvoiceReportViewModel)DataContext).DeleteRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowEditDelete}"
                                        Padding="8,4"/>
                                <Button Classes="save-action" Content="حفظ"
                                        Command="{Binding $parent[DataGrid].((vm:SupplierInvoiceReportViewModel)DataContext).CommitRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowSaveCancel}"
                                        Padding="8,4"/>
                                <Button Content="إلغاء"
                                        Command="{Binding $parent[DataGrid].((vm:SupplierInvoiceReportViewModel)DataContext).CancelEditRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowSaveCancel}"
                                        Padding="8,4"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
