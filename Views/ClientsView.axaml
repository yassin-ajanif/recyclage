<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             x:Class="Recyclage.Views.ClientsView"
             x:DataType="vm:ClientsViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            <TextBlock Text="اضغط «تعديل» لتغيير سطر، أو اكتب في السطر الأخير ثم «حفظ»."
                       Opacity="0.6"
                       FontSize="13"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Right"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="#B45309"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="#D1D5DB">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="الاسم" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ClientRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الهاتف" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ClientRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Phone}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding Phone, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="ICE" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ClientRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Ice}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding Ice, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="إجراءات" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ClientRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Content="تعديل"
                                        Command="{Binding $parent[DataGrid].((vm:ClientsViewModel)DataContext).BeginEditRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowEditDelete}"
                                        Padding="8,4"/>
                                <Button Content="حذف"
                                        Command="{Binding $parent[DataGrid].((vm:ClientsViewModel)DataContext).DeleteRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowEditDelete}"
                                        Padding="8,4"/>
                                <Button Content="حفظ"
                                        Command="{Binding $parent[DataGrid].((vm:ClientsViewModel)DataContext).CommitRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowSaveCancel}"
                                        Padding="8,4"/>
                                <Button Content="إلغاء"
                                        Command="{Binding $parent[DataGrid].((vm:ClientsViewModel)DataContext).CancelEditRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowSaveCancel}"
                                        Padding="8,4"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
