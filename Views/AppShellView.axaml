<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             x:Class="Recyclage.Views.AppShellView"
             x:DataType="vm:AppShellViewModel">

    <!-- Sidebar on the right; RTL text inside each panel -->
    <Grid ColumnDefinitions="*,200" FlowDirection="LeftToRight">
        <Border Grid.Column="0"
                Background="#F9FAFB"
                FlowDirection="RightToLeft">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>

        <Border Grid.Column="1"
                Background="#14532D"
                Padding="12,20"
                FlowDirection="RightToLeft">
            <Grid RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0"
                           Text="إعادة التدوير"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Right"
                           Margin="8,0,8,20"/>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Spacing="4">

                        <!-- العمليات -->
                        <Button Content="العمليات"
                                Command="{Binding ToggleInvoicesCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Classes="nav-section"/>

                        <Border Classes="nav-submenu" IsVisible="{Binding InvoicesExpanded}">
                            <StackPanel Spacing="2">
                                <Button Content="فاتورة مورد"
                                        Command="{Binding GoSupplierReportCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                                <Button Content="فاتورة زبون"
                                        Command="{Binding GoCustomerReportCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                                <Button Content="فاتورة المصاريف"
                                        Command="{Binding GoExpensesCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                            </StackPanel>
                        </Border>

                        <!-- حساباتي -->
                        <Button Content="حساباتي"
                                Command="{Binding ToggleAccountsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Classes="nav-section"/>

                        <Border Classes="nav-submenu" IsVisible="{Binding AccountsExpanded}">
                            <StackPanel Spacing="2">
                                <Button Content="فاتورة المشتريات"
                                        Command="{Binding GoPurchaseInvoicesCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                                <Button Content="فاتورة المبيعات"
                                        Command="{Binding GoSalesCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                                <Button Content="حساب آخر شهر"
                                        Command="{Binding GoMonthlyClosingCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                                <Button Content="حساب بين الشركاء"
                                        Command="{Binding GoPartnerTransactionsCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                            </StackPanel>
                        </Border>

                        <!-- الإعدادات -->
                        <Button Content="الإعدادات"
                                Command="{Binding ToggleSettingsCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Classes="nav-section"/>

                        <Border Classes="nav-submenu" IsVisible="{Binding SettingsExpanded}">
                            <StackPanel Spacing="2">
                                <Button Content="المنتجات"
                                        Command="{Binding GoProductsCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                                <Button Content="الموردون"
                                        Command="{Binding GoSuppliersCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                                <Button Content="الزبائن"
                                        Command="{Binding GoClientsCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                                <Button Content="الإعدادات"
                                        Command="{Binding GoCompanyCapitalCommand}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Classes="nav-item"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.nav-section">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#BBF7D0"/>
            <Setter Property="Padding" Value="12,10,12,12"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav-section /template/ ContentPresenter">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,2,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Border.nav-submenu">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="2,0,0,0"/>
            <Setter Property="Margin" Value="12,2,0,8"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
        </Style>
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="12,8,12,10"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav-item /template/ ContentPresenter">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,2,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav-item:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#166534"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,2,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
</UserControl>
