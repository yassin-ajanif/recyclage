<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             x:Class="Recyclage.Views.PartnerTransactionsView"
             x:DataType="vm:PartnerTransactionsViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            <TextBlock Text="حساب أيوب / مصطفى — عرض وتتبع الرصيد" Opacity="0.6" FontSize="13" HorizontalAlignment="Stretch" TextAlignment="Right"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="تاريخ" Binding="{Binding Date}" Width="110"/>
                <DataGridTextColumn Header="دفع لي أيوب" Binding="{Binding PaidByAyoub}" Width="*"/>
                <DataGridTextColumn Header="رجوع لمصطفى" Binding="{Binding ReturnedToMustafa}" Width="*"/>
                <DataGridTextColumn Header="التفاصيل" Binding="{Binding Details}" Width="*"/>
                <DataGridTextColumn Header="الباقي لأيوب" Binding="{Binding LeftToAyoub}" Width="*"/>
                <DataGridTextColumn Header="الباقي لمصطفى" Binding="{Binding LeftToMustafa}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
