<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             xmlns:behaviors="using:Recyclage.Behaviors"
             xmlns:views="using:Recyclage.Views"
             x:Class="Recyclage.Views.CustomerInvoiceReportView"
             x:DataType="vm:CustomerInvoiceReportViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,16">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
                <TextBlock Text="اضغط «تعديل» لتغيير سطر، أو اكتب في السطر الأخير ثم «حفظ»."
                           Opacity="0.6"
                           FontSize="13"
                           HorizontalAlignment="Stretch"
                           TextAlignment="Right"/>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                    <TextBlock Text="اختر الزبون:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Clients}"
                              SelectedItem="{Binding SelectedClient}"
                              MinWidth="220"/>
                </StackPanel>
            </StackPanel>
            <views:MonthFilterBar Grid.Column="1"
                                  VerticalAlignment="Center"
                                  SelectMonthCommand="{Binding SelectMonthCommand}"/>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,8">
            <TextBlock Text="أضف منتجات «للبيع» من الإعدادات → المنتجات"
                       Foreground="#B45309"
                       TextWrapping="Wrap"
                       IsVisible="{Binding ShowSaleProductsHint}"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#B45309"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2" RowDefinitions="*,Auto">
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      GridLinesVisibility="All"
                      BorderThickness="1,1,1,0"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      MinHeight="200">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="تاريخ" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Date}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <CalendarDatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                                    DisplayDate="{Binding DisplayDate}"
                                                    DisplayDateStart="{Binding $parent[DataGrid].((vm:CustomerInvoiceReportViewModel)DataContext).SelectedMonthStart}"
                                                    DisplayDateEnd="{Binding $parent[DataGrid].((vm:CustomerInvoiceReportViewModel)DataContext).SelectedMonthEnd}"
                                                    SelectedDateFormat="Custom"
                                                    CustomDateFormatString="yyyy-MM-dd"
                                                    IsTodayHighlighted="True"
                                                    IsVisible="{Binding IsEditing}"
                                                    HorizontalAlignment="Stretch"
                                                    MinWidth="130"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الكمية" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Classes="numeric-input" behaviors:TextBoxFocusBehavior.SelectAllOnFocus="True" Text="{Binding Quantity, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="منتج" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <ComboBox ItemsSource="{Binding ProductNames}"
                                          SelectedItem="{Binding ProductName, Mode=TwoWay}"
                                          PlaceholderText="اختر منتج"
                                          MinWidth="140"
                                          HorizontalAlignment="Stretch"
                                          IsVisible="{Binding IsEditing}"
                                          SelectionChanged="OnProductChanged"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="ثمن" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding UnitPrice}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Classes="numeric-input" behaviors:TextBoxFocusBehavior.SelectAllOnFocus="True" Text="{Binding UnitPrice, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="نقل" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding TransportCost}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Classes="numeric-input" behaviors:TextBoxFocusBehavior.SelectAllOnFocus="True" Text="{Binding TransportCost, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="المجموع" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBlock Text="{Binding Total}" Margin="4,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="دفع" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Paid}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Classes="numeric-input" behaviors:TextBoxFocusBehavior.SelectAllOnFocus="True" Text="{Binding Paid, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الباقي" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBlock Text="{Binding Remaining}" Margin="4,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="إجراءات" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Classes="edit-action" Content="تعديل"
                                        Command="{Binding $parent[DataGrid].((vm:CustomerInvoiceReportViewModel)DataContext).BeginEditRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowEditDelete}"
                                        Padding="8,4"/>
                                <Button Classes="delete-action" Content="حذف"
                                        Command="{Binding $parent[DataGrid].((vm:CustomerInvoiceReportViewModel)DataContext).DeleteRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowEditDelete}"
                                        Padding="8,4"/>
                                <Button Classes="save-action" Content="حفظ"
                                        Command="{Binding $parent[DataGrid].((vm:CustomerInvoiceReportViewModel)DataContext).CommitRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowSaveCancel}"
                                        Padding="8,4"/>
                                <Button Content="إلغاء"
                                        Command="{Binding $parent[DataGrid].((vm:CustomerInvoiceReportViewModel)DataContext).CancelEditRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowSaveCancel}"
                                        Padding="8,4"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1"
                    Background="#FAF8F5"
                    BorderBrush="{StaticResource TableGridLineBrush}"
                    BorderThickness="1,0,1,1"
                    Padding="0,8">
                <Grid ColumnDefinitions="150,90,*,100,100,110,100,100,170">
                    <StackPanel Grid.Column="5" Margin="8,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="المجموع" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:0.00} د.م}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Margin="8,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="دفع" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPaid, StringFormat={}{0:0.00} د.م}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="7" Margin="8,0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="الباقي" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalRemaining, StringFormat={}{0:0.00} د.م}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
