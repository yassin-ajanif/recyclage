<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             x:Class="Recyclage.Views.CustomerInvoiceReportView"
             x:DataType="vm:CustomerInvoiceReportViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            <TextBlock Text="إدخال يومي — فاتورة لزبون واحد. الحفظ تلقائي عند الخروج من الحقل."
                       Opacity="0.6"
                       FontSize="13"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Right"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,8" HorizontalAlignment="Left">
            <TextBlock Text="اختر الزبون:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Clients}"
                      SelectedItem="{Binding SelectedClient}"
                      MinWidth="220"/>
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Foreground="#B45309"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="#D1D5DB">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="تاريخ" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBox Text="{Binding Date, Mode=TwoWay}" Margin="4,2" LostFocus="OnAutoSave"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الكمية" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBox Text="{Binding Quantity, Mode=TwoWay}" Margin="4,2" LostFocus="OnAutoSave"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="منتج" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <ComboBox ItemsSource="{Binding $parent[DataGrid].((vm:CustomerInvoiceReportViewModel)DataContext).SaleProducts}"
                                      SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                      Margin="4,2"
                                      SelectionChanged="OnProductChanged"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="ثمن" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBox Text="{Binding UnitPrice, Mode=TwoWay}" Margin="4,2" LostFocus="OnAutoSave"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="نقل" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBox Text="{Binding TransportCost, Mode=TwoWay}" Margin="4,2" LostFocus="OnAutoSave"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="المجموع" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBlock Text="{Binding Total}" Margin="4,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="دفع" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBox Text="{Binding Paid, Mode=TwoWay}" Margin="4,2" LostFocus="OnAutoSave"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الباقي" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <TextBlock Text="{Binding Remaining}" Margin="4,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="حذف" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:SaleEntryRowViewModel">
                            <Button Content="حذف"
                                    Command="{Binding $parent[DataGrid].((vm:CustomerInvoiceReportViewModel)DataContext).DeleteRowCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding CanDelete}"
                                    HorizontalAlignment="Center"
                                    Padding="8,4"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
