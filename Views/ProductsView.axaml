<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             x:Class="Recyclage.Views.ProductsView"
             x:DataType="vm:ProductsViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            <TextBlock Text="منتجات للشراء / للبيع" Opacity="0.6" FontSize="13" HorizontalAlignment="Stretch" TextAlignment="Right"/>
        </StackPanel>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  BorderBrush="#D1D5DB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="نوع المنتج" Binding="{Binding ProductType}" Width="120"/>
                <DataGridTextColumn Header="الوحدة" Binding="{Binding DefaultUnit}" Width="90"/>
                <DataGridTextColumn Header="ثمن افتراضي" Binding="{Binding DefaultUnitPrice}" Width="120"/>
                <DataGridTextColumn Header="نشط" Binding="{Binding IsActive}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
