<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             xmlns:behaviors="using:Recyclage.Behaviors"
             x:Class="Recyclage.Views.ProductsView"
             x:DataType="vm:ProductsViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            <TextBlock Text="اضغط «تعديل» لتغيير سطر، أو اكتب في السطر الأخير ثم «حفظ»."
                       Opacity="0.6"
                       FontSize="13"
                       HorizontalAlignment="Stretch"
                       TextAlignment="Right"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="#B45309"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <DataGrid Grid.Row="2"
                  x:Name="ProductsGrid"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="الاسم" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ProductRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding Name, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="نوع المنتج" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ProductRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding ProductType}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <ComboBox ItemsSource="{x:Static vm:ProductsViewModel.ProductTypeLabels}"
                                          SelectedItem="{Binding ProductType, Mode=TwoWay}"
                                          IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="الوحدة" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ProductRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding DefaultUnit}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Text="{Binding DefaultUnit, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="ثمن افتراضي" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ProductRowViewModel">
                            <Grid Margin="4,2">
                                <TextBlock Text="{Binding DefaultUnitPrice}" VerticalAlignment="Center" IsVisible="{Binding IsDisplayMode}"/>
                                <TextBox Classes="numeric-input" behaviors:TextBoxFocusBehavior.SelectAllOnFocus="True" Text="{Binding DefaultUnitPrice, Mode=TwoWay}" IsVisible="{Binding IsEditing}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="إجراءات" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:ProductRowViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Classes="edit-action" Content="تعديل"
                                        Command="{Binding $parent[DataGrid].((vm:ProductsViewModel)DataContext).BeginEditRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowEditDelete}"
                                        Padding="8,4"/>
                                <Button Classes="delete-action" Content="حذف"
                                        Command="{Binding $parent[DataGrid].((vm:ProductsViewModel)DataContext).DeleteRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowEditDelete}"
                                        Padding="8,4"/>
                                <Button Classes="save-action" Content="حفظ"
                                        Command="{Binding $parent[DataGrid].((vm:ProductsViewModel)DataContext).CommitRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowSaveCancel}"
                                        Padding="8,4"/>
                                <Button Content="إلغاء"
                                        Command="{Binding $parent[DataGrid].((vm:ProductsViewModel)DataContext).CancelEditRowCommand}"
                                        CommandParameter="{Binding}"
                                        IsVisible="{Binding ShowSaveCancel}"
                                        Padding="8,4"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
