<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             xmlns:views="using:Recyclage.Views"
             x:Class="Recyclage.Views.MonthlyClosingReportView"
             x:DataType="vm:MonthlyClosingReportViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
                <TextBlock Text="محسوب من المبيعات والمشتريات والمصاريف والشركاء" Opacity="0.6" FontSize="13" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            </StackPanel>
            <views:MonthFilterBar Grid.Column="1"
                                  VerticalAlignment="Center"
                                  SelectMonthCommand="{Binding SelectMonthCommand}"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="#B45309"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn MinWidth="100" Width="100">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="الشهر" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Month}" Margin="8,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn MinWidth="115" Width="115">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="دخول في شهر" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MonthlyPurchases}" Margin="8,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn MinWidth="120" Width="120">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="المصاريف في شهر" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Expenses}" Margin="8,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn MinWidth="115" Width="115">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="المجموع (د+م)" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TotalIncomePurchases}" Margin="8,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn MinWidth="105" Width="105">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="خروج في شهر" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MonthlySales}" Margin="8,6" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn MinWidth="150" Width="*">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="الباقي" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CapitalRemaining}"
                                       Foreground="{Binding CapitalRemaining, Converter={StaticResource NegativeAmountBrushConverter}}"
                                       Margin="8,6"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn MinWidth="120" Width="120">
                    <DataGridTemplateColumn.Header>
                        <TextBlock Text="رأس مال الشركة" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding CompanyBalance}"
                                       Foreground="{Binding CompanyBalance, Converter={StaticResource NegativeAmountBrushConverter}}"
                                       Margin="8,6"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
