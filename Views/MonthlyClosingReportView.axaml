<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Recyclage.ViewModels"
             xmlns:views="using:Recyclage.Views"
             x:Class="Recyclage.Views.MonthlyClosingReportView"
             x:DataType="vm:MonthlyClosingReportViewModel"
             FlowDirection="RightToLeft">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Stretch" TextAlignment="Right"/>
                <TextBlock Text="محسوب من المبيعات والمشتريات والمصاريف والشركاء" Opacity="0.6" FontSize="13" HorizontalAlignment="Stretch" TextAlignment="Right"/>
            </StackPanel>
            <views:MonthFilterBar Grid.Column="1"
                                  VerticalAlignment="Center"
                                  SelectMonthCommand="{Binding SelectMonthCommand}"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Foreground="#B45309"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserReorderColumns="False"
                  GridLinesVisibility="All"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الشهر" Binding="{Binding Month}" Width="140"/>
                <DataGridTextColumn Header="دخول في شهر" Binding="{Binding Income}" Width="*"/>
                <DataGridTextColumn Header="مصاريف في شهر" Binding="{Binding Expenses}" Width="*"/>
                <DataGridTextColumn Header="مشتريات في شهر" Binding="{Binding Purchases}" Width="*"/>
                <DataGridTextColumn Header="خروج في شهر" Binding="{Binding Outgoing}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
